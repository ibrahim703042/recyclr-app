rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Profile Pictures
    match /users/{userId}/profile.jpg {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // 2. Scan Photos (for verification)
    match /scans/{scanId}/{userId}_photo.jpg {
      allow read: if isSignedIn() && (isOwner(userId) || request.auth.token.admin == true);
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024 // 10MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // 3. Community Posts
    match /posts/{postId}/{userId}_image.jpg {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024 // 10MB limit
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }
  }
}
